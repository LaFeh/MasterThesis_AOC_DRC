st_geometry_type(streets_without_cities)
k =streets_without_cities[which(t_geometry_type(streets_without_cities)=="GEOMETRYCOLLECTION"),]
k =streets_without_cities[which(st_geometry_type(streets_without_cities)=="GEOMETRYCOLLECTION"),]
