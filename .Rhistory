plan(multisession, workers = parallel::detectCores() - 1)
gc()
groups <- settlements_within %>%
group_split(mgrs_code)
settlements_union <- future_map_dfr(groups, function(x) {
x %>%
summarise(
mgrs_code = first(mgrs_code),
geometry = st_union(st_combine(SHAPE)),
building_area_sum = sum(building_area_sum, na.rm = TRUE),
settlement_area_sqm = sum(block_area_sqm, na.rm = TRUE),
