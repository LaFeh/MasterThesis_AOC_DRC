library(bsreg)
# k = bslx(logc~logp+logc+factor(year)+factor(state), data = data,
#          W = krn_dist_mat,X_SLX = SXL,
#          options = set_options(SLX = set_SLX(delta_a=2,delta_b = 2,delta_max = 10)))
dist2_mat = as.matrix(stats::dist(coord[,c("latitude","longitude")]))
#knn <- knearneigh(coord[,c("latitude","longitude")], k = 5)
#nb_knn <- knn2nb(knn)
#Get distance matrix (already computed)
dist_mat_k <- dist2_mat
# dist_mat_k2 = apply(dist_mat_k,c(1,2),
#                      function(x) {if (x != 0) {return(1/(x^gamma))}else{return(0)}})
diag(dist_mat_k) <- Inf
Psi <- function(delta) {
W_dist <- dist_mat_k ^ (-delta) # Build
W_dist <- W_dist / max(eigen(W_dist, symmetric = TRUE)$values) # Scale
return(kronecker(I_T, W_dist))
}
out_slxdx <- bslx(logc~logp+logy+factor(year)+factor(state), data = data, W = Psi, X_SLX = SXL,
n_save = 1000, n_burn = 200, options = set_options(
SLX = set_SLX(delta = 3, delta_scale = 0.05, delta_a = 2, delta_b = 2)))
