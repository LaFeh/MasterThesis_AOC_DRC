library(sf)
library(dplyr)
library(terra)
library(exactextractr)
tif_path <-'./data/GRID3_COD_mix_travel_time_friction_surface_v1/GRID3_COD_mix_travel_time_friction_surface_v1.tif'
mix_time=rast(tif_path)
grid = read_sf("./data/grid_surface.shp")
grid = st_transform(grid,st_crs(mix_time))
# crop raster to grid bounding box
mix_time_crop <- crop(
mix_time,
vect(grid),
filename = "./data/mix_crop.tif",
overwrite = TRUE
)
summary(mix_time_crop)
summary <- exactextractr::exact_extract(mix_time_crop, grid, 'mean')
grid$mix_time_mean <- summary
grid$lg_mix_time_mean = log(grid$mix_time_mean)
library(terra)
threshold <- 10000
cells <- which(values(mix_time_crop) > threshold)
coords <- xyFromCell(mix_time_crop, cells)
pts <- st_as_sf(
as.data.frame(coords),
coords = c("x", "y"),
crs = crs(mix_time_crop)
)
# Find grid cells that contain at least one point
idx <- st_intersects(grid, pts)
# Add a logical column
grid$hit <- lengths(idx) > 0
# Plot
plot(grid[which(grid$hit),]$geometry)
highlight <- mix_time_crop
highlight[cells] <- NA
plot(highlight)
highlight <- mix_time_crop
highlight[values(mix_time_crop) < threshold] <- NA
pal_rev <- leaflet::colorNumeric(
palette = "viridis",
domain = values(highlight),
na.color = "transparent",
reverse = T
)
pal <- leaflet::colorNumeric(
palette = "viridis",
domain = values(highlight),
na.color = "transparent",
reverse = F
)
pal <- leaflet::colorNumeric(
