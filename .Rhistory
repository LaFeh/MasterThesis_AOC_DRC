hist(seg_lengths, breaks = 40)  # uncomment to inspect visually
# ---- 6. Segment midpoints (representative points for accessibility) ---
# These are the points you'll snap onto the network as origins when
# computing network distances to POIs / demand points in the next step.
streets_split <- streets_split %>%
mutate(midpoint = st_line_sample(.,sample = 0.5))
